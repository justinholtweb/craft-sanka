{# The panel on an entry’s edit screen: what Sanka last did with this URL, and what it would do now. #}
<div class="meta sanka-sidebar">
    <div class="field">
        <div class="heading"><label>{{ "Indexing"|t('sanka') }}</label></div>
        <div class="input">
            {% if engines is null %}
                <p class="light smalltext">{{ "No rule covers this entry, so saving it submits nothing."|t('sanka') }}</p>
            {% elseif engines is empty %}
                <p class="light smalltext">{{ "A rule covers this entry, but no engine it names is usable right now."|t('sanka') }}</p>
            {% else %}
                <p class="light smalltext">{{ "Saving submits to {engines}."|t('sanka', { engines: engines|join(', ') }) }}</p>
            {% endif %}

            {% if history is empty %}
                <p class="light smalltext">{{ "Nothing submitted yet."|t('sanka') }}</p>
            {% else %}
                <ul class="sanka-sidebar-history">
                    {% for row in history %}
                        <li>
                            {% include 'sanka/_components/status-badge' with { status: row.status } only %}
                            <span class="light">{{ row.engine }} · {{ row.dateCreated|datetime('short') }}</span>
                        </li>
                    {% endfor %}
                </ul>
                <a class="go smalltext" href="{{ url('sanka/log', { search: url }) }}">{{ "Full history"|t('sanka') }}</a>
            {% endif %}
        </div>
    </div>
</div>

{% css %}
.sanka-sidebar-history { list-style: none; margin: .4rem 0; padding: 0; font-size: 12px; }
.sanka-sidebar-history li { padding: .15rem 0; }
{% endcss %}
